DATABASE_URL=postgres://rephoto:rephoto@localhost:5432/rephoto
# Max connections per process (api or worker). Default 10. Keep api*2+worker*8 under the RDS limit.
DATABASE_POOL_MAX=10
# Required together for MinIO. Omit S3_ENDPOINT, S3_ACCESS_KEY, and S3_SECRET_KEY on ECS (task role).
# S3_FORCE_PATH_STYLE defaults to true when S3_ENDPOINT is set, and false on real AWS.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=rephoto
# v6 hardening H3: the bucket-scoped application user that `minio-init` creates
# (deploy/scripts/minio-provision.sh), NOT the MinIO root user. It may only get/put/delete
# objects inside S3_BUCKET. Root (`rephoto` / `rephoto-secret`) is for the console on :9001,
# `mc` and minio-init. If your stack predates this change, see "MinIO credentials" in RUN.md:
# `docker compose up -d --force-recreate minio-init` creates the user, then change these two
# lines and restart `dev:api` / `dev:worker`.
S3_ACCESS_KEY=rephoto-app
S3_SECRET_KEY=rephoto-app-secret
S3_REGION=eu-central-1
S3_FORCE_PATH_STYLE=true
SESSION_SECRET=dev-only-change-me-please-32chars
# fake = no dependencies (default). insightface = self-hosted engine: needs the face-service
# (docker compose up -d starts it) and a pgvector-enabled Postgres (pgvector/pgvector:pg16, as in
# docker-compose.yml). rekognition = AWS.
FACE_ENGINE=fake
# The face-service (apps/face-service), used when FACE_ENGINE=insightface.
FACE_SERVICE_URL=http://localhost:8090
# InsightFace thresholds (cosine, 0..1). MIN: below it a pair is not a match ("Forse sei tu"
# starts here, score 0.8). SURE: score 1 ("Le tue foto"). Defaults 0.50 / 0.70 (v5).
# INSIGHTFACE_MIN_COSINE=0.50
# INSIGHTFACE_SURE_COSINE=0.70
# `attach`: an anchor face must be at least this close to a new face (default 0.55).
# INSIGHTFACE_ATTACH_MIN_COSINE=0.55
# `match`: only hits at or above this become anchors. Default = INSIGHTFACE_SURE_COSINE.
# INSIGHTFACE_ANCHOR_MIN_COSINE=0.70
# Rows returned per vector search (default 200) and faces asked per indexed photo (default 100, max 150).
# INSIGHTFACE_MAX_FACES=200
# INSIGHTFACE_INDEX_MAX_FACES=100
# Faces below this engine quality are not indexed (default 0.2).
# INSIGHTFACE_MIN_FACE_QUALITY=0.2
# Selfie gate: largest face long edge in px of the image sent to the engine (default 120) and its
# engine quality (default 0.6). Rejections show a reason in the gallery.
# SELFIE_MIN_FACE_PX=120
# SELFIE_MIN_QUALITY=0.6
# What `index` sends to the engine: original (a detection JPEG rendered at FACE_DETECT_LONG_EDGE,
# default for insightface) or web (the 1600 px derivative, default for fake/rekognition).
# FACE_INDEX_SOURCE=original
# FACE_DETECT_LONG_EDGE=2560
# Test campaign: log every match run and its hits (match_runs/match_hits), keep selfie objects and
# record their key on the gallery, add photoId/userId/eventId to worker log lines. All default false.
# MATCH_LOG=false
# KEEP_SELFIES=false
# LOG_IDS=false
AWS_REGION=eu-central-1
REKOGNITION_COLLECTION_PREFIX=rephoto-
# SearchFacesByImage / SearchFaces MaxFaces. Allowed 1–4096. Default 500.
REKOGNITION_SEARCH_MAX_FACES=500
# Token bucket per worker process (not per account): IndexFaces and Search* calls per second.
# With N worker instances the account-level rate is N times these values. Default 5 each.
REKOGNITION_INDEX_TPS=5
REKOGNITION_SEARCH_TPS=5
# smtp = Mailpit locally (no auth, no TLS) or any provider's SMTP endpoint in production.
# ses = SESv2 in AWS_REGION (SMTP_HOST and SMTP_PORT not required).
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@rephoto.local
# Provider credentials; leave empty for Mailpit (no AUTH).
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE: implicit TLS (SMTPS). Default: true on port 465, false otherwise.
# SMTP_SECURE=false
# SMTP_STARTTLS: auto (upgrade when offered, default) | true (require) | false (never).
# SMTP_STARTTLS=auto
# Demo users are inserted on boot unless NODE_ENV=production or SEED_DEMO=false.
# SEED_DEMO=true
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8787
# How many proxies append to x-forwarded-for before the api (Next.js proxy = 1; ALB+CloudFront in
# front of it = 2, as set by infra/cdk). The client IP is the entry that many hops from the end of the header. Default 1.
TRUSTED_PROXY_HOPS=1

# Worker
# Jobs in flight per worker process. Default 4.
WORKER_CONCURRENCY=4
# Publish rephoto/QueueDepth to CloudWatch every 30 s (needs cloudwatch:PutMetricData). Used by
# the ECS worker autoscaling in infra/cdk. Keep false locally.
WORKER_PUBLISH_METRICS=false

# Web (Next.js). NEXT_PUBLIC_* values are inlined at build time.
# Event slug the public gallery pages point at.
NEXT_PUBLIC_EVENT_SLUG=demo
# Space-separated origins that serve presigned object URLs (CSP img-src/connect-src). Local: MinIO.
NEXT_PUBLIC_MEDIA_ORIGINS=http://localhost:9000
# Public origin of the web app, inlined at build time (used for absolute links / CSP).
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000
# Where the Next.js /v1/* proxy forwards to. In compose `app` profile: http://api:8787.
API_PROXY_TARGET=http://localhost:8787

# =============================================================================
# Production / Coolify deploy (test env on framesofme.com)
# -----------------------------------------------------------------------------
# Set these in Coolify (Environment Variables), not in the repo. The compose file
# docker-compose.coolify.yml reads every value as ${VAR}. Example values below are
# placeholders — replace the secrets. Public hostnames are fronted by a Cloudflare
# Tunnel to Coolify's Traefik; no host ports are published.
#
#   WEB_ORIGIN=https://framesofme.com
#   API_ORIGIN=https://api.framesofme.com
#   API_PROXY_TARGET=http://api:8787           # internal: web -> api over the compose network
#   NEXT_PUBLIC_WEB_ORIGIN=https://framesofme.com
#   NEXT_PUBLIC_MEDIA_ORIGINS=https://s3.framesofme.com   # browser reaches MinIO here (presigned URLs)
#   S3_ENDPOINT=https://s3.framesofme.com      # the api signs URLs against this public host (SigV4 host must match)
#   S3_BUCKET=rephoto
#   # v6 hardening H3: api and worker are no longer root. The application key is required
#   # (no default on purpose), root is its own account. Migration order, and what happens if
#   # you deploy before adding it: RUN.md -> "Coolify: read this BEFORE the next deploy".
#   S3_APP_SECRET_KEY=<random, openssl rand -base64 24>   # REQUIRED; the deploy fails without it
#   S3_APP_ACCESS_KEY=rephoto-app              # optional, this default is fine (a username)
#   MINIO_ROOT_USER=<minio-root-user>          # set to what S3_ACCESS_KEY holds today
#   MINIO_ROOT_PASSWORD=<minio-root-password>  # set to what S3_SECRET_KEY holds today
#   # S3_ACCESS_KEY / S3_SECRET_KEY: the OLD pair. Nothing reads them once MINIO_ROOT_* are
#   # set; until then root still falls back to them, which is what keeps step 1 safe.
#   SESSION_SECRET=<32+ random chars>          # e.g. `openssl rand -base64 32`
#   FACE_ENGINE=fake                           # or insightface (needs the face-service + pgvector)
#   MAIL_TRANSPORT=smtp
#   SMTP_HOST=mailpit                          # internal Mailpit (test), or a real provider in prod
#   SMTP_PORT=1025
#   SMTP_FROM=noreply@framesofme.com
#   BOOTSTRAP_ADMINS=havrestiucruben@gmail.com # comma-separated: upserted as admin on API boot
#   TRUSTED_PROXY_HOPS=2                        # Cloudflare + Traefik in front of the api
#   # SEED_DEMO is set to "true" ONLY on the one-shot `migrate` service (seeds the demo event);
#   # leave it unset on api/worker so demo staff passwords are never created on a public site.
# =============================================================================
