DATABASE_URL=postgres://rephoto:rephoto@localhost:5432/rephoto
# Max connections per process (api or worker). Default 10. Keep api*2+worker*8 under the RDS limit.
DATABASE_POOL_MAX=10
# Required together for MinIO. Omit S3_ENDPOINT, S3_ACCESS_KEY, and S3_SECRET_KEY on ECS (task role).
# S3_FORCE_PATH_STYLE defaults to true when S3_ENDPOINT is set, and false on real AWS.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=rephoto
S3_ACCESS_KEY=rephoto
S3_SECRET_KEY=rephoto-secret
S3_REGION=eu-central-1
S3_FORCE_PATH_STYLE=true
SESSION_SECRET=dev-only-change-me-please-32chars
FACE_ENGINE=fake
AWS_REGION=eu-central-1
REKOGNITION_COLLECTION_PREFIX=rephoto-
# SearchFacesByImage / SearchFaces MaxFaces. Allowed 1–4096. Default 500.
REKOGNITION_SEARCH_MAX_FACES=500
# Token bucket per worker process (not per account): IndexFaces and Search* calls per second.
# With N worker instances the account-level rate is N times these values. Default 5 each.
REKOGNITION_INDEX_TPS=5
REKOGNITION_SEARCH_TPS=5
# smtp = Mailpit. ses = SESv2 in AWS_REGION (SMTP_HOST and SMTP_PORT not required).
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@rephoto.local
# Demo users are inserted on boot unless NODE_ENV=production or SEED_DEMO=false.
# SEED_DEMO=true
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8787
# How many proxies append to x-forwarded-for before the api (Next.js proxy = 1; ALB+CloudFront in
# front of it = 2, as set by infra/cdk). The client IP is the entry that many hops from the end of the header. Default 1.
TRUSTED_PROXY_HOPS=1

# Worker
# Jobs in flight per worker process. Default 4.
WORKER_CONCURRENCY=4
# Publish rephoto/QueueDepth to CloudWatch every 30 s (needs cloudwatch:PutMetricData). Used by
# the ECS worker autoscaling in infra/cdk. Keep false locally.
WORKER_PUBLISH_METRICS=false

# Web (Next.js). NEXT_PUBLIC_* values are inlined at build time.
# Event slug the public gallery pages point at.
NEXT_PUBLIC_EVENT_SLUG=demo
# Space-separated origins that serve presigned object URLs (CSP img-src/connect-src). Local: MinIO.
NEXT_PUBLIC_MEDIA_ORIGINS=http://localhost:9000
# Where the Next.js /v1/* proxy forwards to. In compose `app` profile: http://api:8787.
API_PROXY_TARGET=http://localhost:8787
