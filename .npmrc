# Flat node_modules (like npm): keeps Next.js standalone dependency tracing working and
# avoids strict-isolation breakage during the npm -> pnpm migration.
node-linker=hoisted
# Link the internal @rephoto/* packages from the workspace regardless of their version
# specifier (file:../ or bare 0.0.0), instead of looking them up on the registry.
link-workspace-packages=true
# Reproducible CI/Docker installs.
engine-strict=false
