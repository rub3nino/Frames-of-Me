# RePhoto v4 — production environment for deploy/compose.yml.
#
#   cp .env.production.example .env.production
#   ./scripts/gen-secrets.sh .env.production      # fills every "GENERATE" value
#   docker compose --env-file .env.production config   # must print the stack without errors
#
# Compose interpolates this file: a literal `$` must be written `$$` (gen-secrets.sh does it
# for the bcrypt hash). Never commit .env.production.

# ---------------------------------------------------------------- domain and TLS
# Apex host of the app. DNS A/AAAA records needed: DOMAIN, www.DOMAIN, media.DOMAIN, status.DOMAIN.
DOMAIN=rephoto.example.com
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=ops@example.com
# Event slug the public pages point at (NEXT_PUBLIC_EVENT_SLUG, inlined in the web image at build).
EVENT_SLUG=conferenza-2026

# ---------------------------------------------------------------- Postgres (pgvector/pg16)
POSTGRES_USER=rephoto
POSTGRES_PASSWORD=GENERATE
POSTGRES_DB=rephoto
# Tuning for 32 GB RAM shared with MinIO, face-service and the Node processes. See README § 1.
POSTGRES_SHARED_BUFFERS=4GB
POSTGRES_EFFECTIVE_CACHE_SIZE=12GB
# api 2×DATABASE_POOL_MAX + worker 2×DATABASE_POOL_MAX + face engine 4 each + backup; 200 is plenty.
POSTGRES_MAX_CONNECTIONS=200
# Pool per api/worker process.
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------- MinIO (objects)
# Root credentials. Used ONLY by `minio-init` (which creates the bucket, the application policy
# and the application user) and by the `backup` sidecar (`mc mirror` has to list the bucket, a
# restore has to write it back). They are never passed to api or worker — see README § 6 bis.
MINIO_ROOT_USER=rephoto
MINIO_ROOT_PASSWORD=GENERATE
S3_BUCKET=rephoto
# Application credentials for api and worker (S3_ACCESS_KEY / S3_SECRET_KEY). This user may only
# read, write and delete objects inside S3_BUCKET: no bucket creation or deletion, no listing, no
# admin actions, no other bucket (v6 F2, deploy/scripts/minio-provision.sh).
# To rotate: change the secret, `docker compose up -d --force-recreate minio-init api worker`.
S3_APP_ACCESS_KEY=rephoto-app
S3_APP_SECRET_KEY=GENERATE
# Where the objects live: a named volume (default `minio_data`) or an absolute path on the big
# disk, e.g. /srv/rephoto/minio. 150k photos × 8 MB ≈ 1.2 TB plus ~70 GB of derivatives.
MINIO_DATA_DIR=minio_data

# ---------------------------------------------------------------- sessions
# ≥ 32 random chars; rotating it logs everyone out.
SESSION_SECRET=GENERATE

# ---------------------------------------------------------------- face engine
# insightface (self-hosted, default) | rekognition (needs AWS credentials in the environment) | fake
FACE_ENGINE=insightface
# Cosine thresholds of the InsightFace adapter (v5 defaults, see docs/v5-test-readiness-spec.md).
INSIGHTFACE_MIN_COSINE=0.50
INSIGHTFACE_SURE_COSINE=0.70
INSIGHTFACE_MAX_FACES=200
INSIGHTFACE_MIN_FACE_QUALITY=0.2
# Token buckets per worker process (index / search calls per second).
FACE_INDEX_TPS=20
FACE_SEARCH_TPS=20
# Ask the face service for a liveness verdict on each selfie (`match` job). Default off.
LIVENESS_CHECK=false
# CPU threads and limits of the face-service container (one process, ONNX intra-op threads).
FACE_SERVICE_THREADS=4
FACE_SERVICE_CPUS=4
FACE_SERVICE_MEMORY=4g

# ---------------------------------------------------------------- replicas and worker
API_REPLICAS=2
WORKER_REPLICAS=2
# Jobs in flight per worker process (1–32).
WORKER_CONCURRENCY=4
WORKER_CPUS=3
WORKER_MEMORY=4g

# ---------------------------------------------------------------- retention (v6 G)
# The retention job is enqueued by the worker itself, once per event per window: no host cron.
# false = nobody schedules it any more; the retention has to be launched from /admin (or by an
# external cron calling POST /v1/admin/retention/run) and the admin screen shows the alarm.
RETENTION_SCHEDULER=true
# Window length. Aligned to the epoch in UTC, so 24 turns over at 00:00 UTC.
RETENTION_WINDOW_HOURS=24
# How often the worker looks for a window to claim (seconds). Well below the window.
RETENTION_TICK_SECONDS=300
# Mail the alarm (failed / job_error / skipped) through the SMTP provider configured above.
# One message per window while the problem lasts, one when it clears. false = only the log line
# and the red box on /admin, which nobody is watching at 03:00.
RETENTION_ALARM_MAIL=true
# Who gets it, comma-separated. Empty = fall back to BOOTSTRAP_ADMINS; with both empty nothing
# is sent and the worker logs `alarmMail: "no-recipient"`.
RETENTION_ALARM_EMAIL=ops@example.com

# ---------------------------------------------------------------- mail (provider SMTP)
# Sender shown to participants; its domain must have SPF/DKIM at the provider (README § 8).
SMTP_FROM=RePhoto <noreply@example.com>
# Provider SMTP endpoint and credentials: Brevo smtp-relay.brevo.com:587, Postmark smtp.postmarkapp.com:587,
# SES email-smtp.eu-central-1.amazonaws.com:587, Mailgun smtp.eu.mailgun.org:587 ...
# The api authenticates (AUTH) and encrypts (STARTTLS on 587, implicit TLS on 465) by itself.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=apikey-user@example.com
SMTP_PASSWORD=GENERATE_AT_PROVIDER
# true = implicit TLS from the first byte (port 465); false = plain connection upgraded with STARTTLS (port 587).
SMTP_SECURE=false
# auto = STARTTLS when the server offers it; true = refuse to send without it (keep it on 587).
SMTP_STARTTLS=true

# ---------------------------------------------------------------- backup
# Absolute path on a SECOND disk or a mounted storage box; receives postgres/*.dump and objects/.
BACKUP_DIR=/srv/rephoto/backup
BACKUP_KEEP_DAYS=7
# Daily time (HH:MM, container TZ = UTC).
BACKUP_AT=03:30

# ---------------------------------------------------------------- status page (uptime-kuma)
# Basic auth in front of status.DOMAIN. Hash from `caddy hash-password`, with `$` doubled.
STATUS_BASIC_AUTH_USER=admin
STATUS_BASIC_AUTH_HASH=$$2a$$14$$GENERATE

# ---------------------------------------------------------------- images
# Tag given to the locally built images (rephoto-api:TAG ...). Use a git sha to keep rollbacks easy.
IMAGE_TAG=latest

# ---------------------------------------------------------------- Test campaign (compose.test.yml, docs/test-readiness.md)
# Everything below is read only when compose.test.yml is layered on compose.yml; commented
# values are the defaults the override applies. Uncomment to change. Not for production.
#
# face-service: uvicorn processes (16 vCPU: 2), detector input size and the long edge the
# image is scaled to before detection (2560/1024 finds 60–80 px faces in a 24 MP hall photo).
#FACE_SERVICE_WORKERS=2
#FACE_DET_SIZE=1024
#FACE_DET_LONG_EDGE=2560
# Concurrent model inferences per face-service process.
#FACE_MODEL_CONCURRENCY=2
# Worker: index from the original (rendered to FACE_DETECT_LONG_EDGE px) instead of the 1600 px web derivative.
#FACE_INDEX_SOURCE=original
#FACE_DETECT_LONG_EDGE=2560
# Recognition: attach threshold (anchor ↔ face), separate from INSIGHTFACE_MIN_COSINE.
#INSIGHTFACE_ATTACH_MIN_COSINE=0.55
# Record every match hit with its raw cosine in match_runs/match_hits (admin export, evaluate.py sweep).
#MATCH_LOG=true
# Keep the selfie object after the match (galleries.selfie_key) so an admin can re-run it. Consent text must say so.
#KEEP_SELFIES=true
# photoId/userId/eventId in every worker log line.
#LOG_IDS=true
# Rate limits: 0 = off. Production defaults are 3 / 20 / 5.
#MAGIC_LINK_PER_EMAIL=0
#MAGIC_LINK_PER_IP=0
#SELFIE_MAX_PER_HOUR=0
# IPs or CIDRs that skip the limits (the hall's NAT, the ops laptop): comma-separated.
#RATE_LIMIT_EXEMPT_IPS=
# Admin users upserted at api boot (comma-separated e-mails); get their link from /staff.
#BOOTSTRAP_ADMINS=
# Mailpit UI (mail.DOMAIN): defaults to the status.* credentials when unset.
#MAIL_BASIC_AUTH_USER=admin
#MAIL_BASIC_AUTH_HASH=$$2a$$14$$GENERATE
